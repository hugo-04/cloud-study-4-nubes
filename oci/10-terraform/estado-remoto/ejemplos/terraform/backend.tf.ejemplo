# Opción A — backend nativo de OCI (Terraform 1.12+; verifica atributos vigentes)
terraform {
  backend "oci" {
    bucket    = "tfstate-modalima"
    namespace = "NAMESPACE"
    key       = "modalima/prod/tienda.tfstate"
    region    = "sa-saopaulo-1"
    # auth = "InstancePrincipal" en runners dentro de OCI
  }
}

