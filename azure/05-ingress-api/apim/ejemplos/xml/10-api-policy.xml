<!--
  Política a nivel de API "pedidos" (ModaLima):
  JWT de Entra ID + límite por suscripción/consumidor + correlación + identidad administrada hacia el backend
  + timeout explícito + reintento SOLO para GET + errores en problem+json + limpieza de cabeceras.
  Los {{named-values}} se definen en APIM (tenant-id y audiencias; los secretos van a Key Vault).
-->
<policies>
  <inbound>
    <base />

    <!-- 1. Validar el token del consumidor -->
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401"
                  failed-validation-error-message="Token inválido o ausente"
                  require-scheme="Bearer" require-expiration-time="true" require-signed-tokens="true"
                  output-token-variable-name="jwt">
      <openid-config url="https://login.microsoftonline.com/{{tenant-id}}/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>api://modalima-pedidos</audience>
      </audiences>
      <issuers>
        <issuer>https://login.microsoftonline.com/{{tenant-id}}/v2.0</issuer>
      </issuers>
      <required-claims>
        <claim name="roles" match="any">
          <value>Pedidos.Leer</value>
          <value>Pedidos.Escribir</value>
        </claim>
      </required-claims>
    </validate-jwt>

    <!-- 2. Límite por consumidor (suscripción, o app del token si no hay suscripción). NO por IP si hay un gateway delante -->
    <rate-limit-by-key calls="100" renewal-period="60"
                       counter-key="@(context.Subscription?.Id ?? ((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("azp", new string[] { "anonimo" })[0])"
                       increment-condition="@(!(context.Response.StatusCode >= 500))" />

    <!-- 3. Correlación y consumidor para el backend -->
    <set-header name="X-Correlation-Id" exists-action="skip">
      <value>@(Guid.NewGuid().ToString())</value>
    </set-header>
    <set-header name="X-Consumer-Id" exists-action="override">
      <value>@(context.Subscription?.Id ?? "sin-suscripcion")</value>
    </set-header>
    <!-- Si hay Application Gateway/Front Door delante, X-Forwarded-For ya viene; solo se añade si falta -->
    <set-header name="X-Forwarded-For" exists-action="skip">
      <value>@(context.Request.IpAddress)</value>
    </set-header>

    <!-- 4. El backend no recibe la clave de suscripción ni el token del consumidor -->
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <authentication-managed-identity resource="api://modalima-backend" output-token-variable-name="tokenBackend" ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["tokenBackend"])</value>
    </set-header>

    <!-- 5. Destino -->
    <set-backend-service backend-id="backend-pedidos" />
  </inbound>

  <backend>
    <!-- Reintento solo para lecturas idempotentes -->
    <retry condition="@(context.Request.Method == "GET" ? (context.Response.StatusCode == 503 || context.Response.StatusCode == 502) : false)"
           count="2" interval="1" first-fast-retry="true">
      <forward-request timeout="20" buffer-request-body="true" />
    </retry>
  </backend>

  <outbound>
    <base />
    <set-header name="X-Powered-By" exists-action="delete" />
    <set-header name="Server" exists-action="delete" />
    <set-header name="X-Content-Type-Options" exists-action="override">
      <value>nosniff</value>
    </set-header>
    <set-header name="Strict-Transport-Security" exists-action="override">
      <value>max-age=31536000; includeSubDomains</value>
    </set-header>
  </outbound>

  <on-error>
    <base />
    <!-- Respuesta de error uniforme (RFC 7807) -->
    <set-header name="Content-Type" exists-action="override">
      <value>application/problem+json</value>
    </set-header>
    <set-body>@{
        var estado = context.Response.StatusCode;
        return new JObject(
            new JProperty("type", "https://api.modalima.example/errores/gateway"),
            new JProperty("title", context.LastError?.Reason ?? "Error"),
            new JProperty("status", estado),
            new JProperty("correlationId", context.Request.Headers.GetValueOrDefault("X-Correlation-Id", context.RequestId.ToString()))
        ).ToString();
    }</set-body>
  </on-error>
</policies>
