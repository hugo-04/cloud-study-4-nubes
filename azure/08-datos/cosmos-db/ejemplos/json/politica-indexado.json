{
  "indexingMode": "consistent",
  "automatic": true,
  "includedPaths": [
    { "path": "/*" }
  ],
  "excludedPaths": [
    { "path": "/notas/*" },
    { "path": "/direccionEntrega/*" },
    { "path": "/\"_etag\"/?" }
  ],
  "compositeIndexes": [
    [
      { "path": "/estado", "order": "ascending" },
      { "path": "/creadoEn", "order": "descending" }
    ]
  ]
}
