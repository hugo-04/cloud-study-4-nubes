{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SoloCloudFrontLee",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::modalima-sitio-prod/*",
      "Condition": {
        "StringEquals": { "AWS:SourceArn": "arn:aws:cloudfront::111122223333:distribution/E123ABCDEF4567" }
      }
    },
    {
      "Sid": "SoloTLS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::modalima-sitio-prod", "arn:aws:s3:::modalima-sitio-prod/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
