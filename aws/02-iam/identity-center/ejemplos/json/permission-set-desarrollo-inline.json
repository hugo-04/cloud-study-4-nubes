{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SinIamNiOrganizacion",
      "Effect": "Deny",
      "Action": ["iam:*", "organizations:*", "account:*"],
      "Resource": "*"
    },
    {
      "Sid": "SoloRegionesAprobadas",
      "Effect": "Deny",
      "NotAction": ["iam:*", "organizations:*", "support:*", "cloudfront:*", "route53:*"],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": { "aws:RequestedRegion": ["us-east-1", "us-west-2"] }
      }
    }
  ]
}
