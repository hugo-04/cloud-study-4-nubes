{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Escribir",
      "Effect": "Allow",
      "Action": [
        "kinesis:PutRecord",
        "kinesis:PutRecords"
      ],
      "Resource": "arn:aws:kinesis:us-east-1:111122223333:stream/prod-clics"
    },
    {
      "Sid": "CifrarConKms",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:111122223333:key/<id-de-la-clave>"
    }
  ]
}