{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Conectar",
      "Effect": "Allow",
      "Action": [
        "kafka-cluster:Connect",
        "kafka-cluster:DescribeCluster"
      ],
      "Resource": "arn:aws:kafka:us-east-1:111122223333:cluster/prod-pedidos/<uuid>"
    },
    {
      "Sid": "Escribir",
      "Effect": "Allow",
      "Action": [
        "kafka-cluster:DescribeTopic",
        "kafka-cluster:WriteData",
        "kafka-cluster:WriteDataIdempotently"
      ],
      "Resource": [
        "arn:aws:kafka:us-east-1:111122223333:topic/prod-pedidos/<uuid>/pedidos.orden.*",
        "arn:aws:kafka:us-east-1:111122223333:cluster/prod-pedidos/<uuid>"
      ]
    }
  ]
}