{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerSoloMiRama",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:GetParameter", "ssm:GetParameters"],
      "Resource": [
        "arn:aws:ssm:us-east-1:111122223333:parameter/prod/pedidos",
        "arn:aws:ssm:us-east-1:111122223333:parameter/prod/pedidos/*"
      ]
    },
    {
      "Sid": "DescifrarSecureString",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:111122223333:key/11111111-2222-3333-4444-555555555555",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.us-east-1.amazonaws.com" }
      }
    }
  ]
}
