{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerSoloMiSecreto",
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret"],
      "Resource": "arn:aws:secretsmanager:us-east-1:111122223333:secret:prod/pedidos/db-??????",
      "Condition": {
        "ForAnyValue:StringEquals": { "secretsmanager:VersionStage": "AWSCURRENT" }
      }
    },
    {
      "Sid": "DescifrarConLaClave",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:111122223333:key/11111111-2222-3333-4444-555555555555",
      "Condition": {
        "StringEquals": { "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com" }
      }
    }
  ]
}
