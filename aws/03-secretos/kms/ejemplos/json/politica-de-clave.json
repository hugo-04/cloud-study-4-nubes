{
  "Version": "2012-10-17",
  "Id": "politica-clave-pedidos",
  "Statement": [
    {
      "Sid": "HabilitarIamEnLaCuenta",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::111122223333:root" },
      "Action": "kms:*",
      "Resource": "*"
    },
    {
      "Sid": "AdministradoresSinUso",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::111122223333:role/administrador-claves" },
      "Action": [
        "kms:Create*", "kms:Describe*", "kms:Enable*", "kms:List*", "kms:Put*", "kms:Update*",
        "kms:Revoke*", "kms:Disable*", "kms:Get*", "kms:Delete*", "kms:TagResource", "kms:UntagResource",
        "kms:ScheduleKeyDeletion", "kms:CancelKeyDeletion"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UsoDeLaAplicacionSoloPorSusServicios",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::111122223333:role/pedidos-app-tarea" },
      "Action": ["kms:Decrypt", "kms:GenerateDataKey", "kms:DescribeKey"],
      "Resource": "*",
      "Condition": {
        "StringEquals": { "kms:EncryptionContext:servicio": "pedidos" }
      }
    }
  ]
}
